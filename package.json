    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "grammy": "^1.46.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
