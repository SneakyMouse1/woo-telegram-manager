meta {
  name: Order Created - B2B (B2BKing)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/webhooks/woocommerce/{{storeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-wc-webhook-topic: order.created
  x-wc-webhook-resource: order
  x-wc-webhook-event: created
}

body:json {
  {
    "id": 9902,
