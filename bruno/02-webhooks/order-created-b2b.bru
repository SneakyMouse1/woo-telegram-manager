script:pre-request {
  const crypto = require('crypto');
  const secret = bru.getEnvVar('webhookSecret');
  if (secret) {
    const rawBody = JSON.stringify(req.getBody());
    const hmac = crypto.createHmac('sha256', secret).update(rawBody).digest('base64');
    req.setHeader('x-wc-webhook-signature', hmac);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("B2B order webhook received successfully", function() {
    const data = res.getBody();
    expect(data.received).to.equal(true);
    expect(data.orderId).to.equal(9902);
  });
}

docs {
  Simulates an incoming `order.created` webhook for a wholesale B2B order.
  - Recognizes `b2bking_is_b2b_order: 'yes'`, company name, and VAT ID metadata.
  - Triggers Telegram card with the `🏢 B2B Order` / `🏢 Pedido B2B` badge.
}
