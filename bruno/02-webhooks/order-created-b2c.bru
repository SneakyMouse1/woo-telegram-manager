meta {
  name: Order Created - B2C Standard
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/webhooks/woocommerce/{{storeId}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-wc-webhook-topic: order.created
  x-wc-webhook-resource: order
  x-wc-webhook-event: created
}

body:json {
  {
    "id": 9901,
    "number": "9901",
    "status": "processing",
    "currency": "EUR",
    "currency_symbol": "€",
    "date_created": "2026-10-08T12:00:00",
    "total": "75.50",
    "total_tax": "13.10",
    "shipping_total": "4.95",
    "payment_method": "stripe",
    "payment_method_title": "Credit Card (Stripe)",
    "transaction_id": "ch_3N1234567890abcdef",
    "customer_note": "Please leave at front door.",
    "billing": {
      "first_name": "Jane",
      "last_name": "Doe",
      "company": "",
      "address_1": "123 Demo Street, Apt 4B",
      "city": "Madrid",
      "postcode": "28001",
      "country": "ES",
      "email": "jane.doe@example.com",
      "phone": "+34612345678"
    },
    "shipping": {
      "first_name": "Jane",
      "last_name": "Doe",
      "company": "",
      "address_1": "123 Demo Street, Apt 4B",
      "city": "Madrid",
      "postcode": "28001",
      "country": "ES",
      "phone": "+34612345678"
    },
    "line_items": [
      {
        "id": 1,
        "name": "Demo Organic Face Cream 50ml",
        "product_id": 101,
        "quantity": 1,
        "subtotal": "58.26",
        "total": "58.26",
        "sku": "DEMO-CREAM-01",
        "price": 70.50
      }
    ],
    "meta_data": []
  }
}

script:pre-request {
  const crypto = require('crypto');
  const secret = bru.getEnvVar('webhookSecret');
  if (secret) {
    const rawBody = JSON.stringify(req.getBody());
    const hmac = crypto.createHmac('sha256', secret).update(rawBody).digest('base64');
    req.setHeader('x-wc-webhook-signature', hmac);
  }
}

tests {
  test("Status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Order webhook received successfully", function() {
    const data = res.getBody();
    expect(data.received).to.equal(true);
    expect(data.orderId).to.equal(9901);
  });
}

docs {
  Simulates an incoming `order.created` webhook for a retail B2C customer.
  - Automatically triggers Telegram notification to store managers with WhatsApp direct link and line items.
  - If `webhookSecret` is set in the active Bruno environment, the pre-request script computes and attaches the `x-wc-webhook-signature` header automatically.
}
