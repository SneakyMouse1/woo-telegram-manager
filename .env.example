# ==============================================================================
# Environment Configuration
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=3000

# Database
# PostgreSQL connection string with credentials and database name
DATABASE_URL="postgresql://woo_user:woo_password@localhost:5432/woo_telegram_manager?schema=public"

# Security: AES-256-GCM Encryption Key (REQUIRED)
# Must be a 64-character (32-byte) hex string for store credential encryption.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Telegram Bot Owner / Admin Chat ID (REQUIRED)
# Numeric chat ID of the primary administrator.
ADMIN_CHAT_ID=""

# Telegram Bot Token (REQUIRED)
# Format: <digits>:<35+ characters>
TELEGRAM_BOT_TOKEN=""

# Telegram Bot Username (optional, without @)
TELEGRAM_BOT_USERNAME=""

# Public Backend URL (REQUIRED)
# Base URL for webhook endpoints. In production must use HTTPS.
PUBLIC_BACKEND_URL="https://bot.example.com"

# Reverse Proxy Trust Configuration (0 to 5, default: 1)
TRUST_PROXY_HOPS=1

# Optional Debugging Flags
DEBUG=false
SETUP_BOT_METADATA=false