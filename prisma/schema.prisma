datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

/// WooCommerce Store connected to the bot
model Store {
  id                     String   @id @default(uuid()) @db.Uuid
  name                   String   @unique @db.VarChar(255)
  url                    String   @unique @map("url") @db.VarChar(500)
  apiKeyEncrypted        String   @map("api_key_encrypted") @db.Text
  apiSecretEncrypted     String   @map("api_secret_encrypted") @db.Text
  webhookSecretEncrypted String?  @map("webhook_secret_encrypted") @db.Text
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")

  // Relations
  members StoreMember[]

  @@map("stores")
}

/// Authorized Telegram bot users with roles/labels
model ChatUser {
  chatId    BigInt   @id @map("chat_id")
  label     String   @db.VarChar(255)
  language  String   @default("ru") @db.VarChar(10)
  isManual  Boolean  @default(false) @map("is_manual")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  storeMembers StoreMember[]

  @@map("chat_users")
}

/// Membership linking chat users to specific stores
model StoreMember {
  chatId    BigInt   @map("chat_id")
  storeId   String   @map("store_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  store Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  ChatUser @relation(fields: [chatId], references: [chatId], onDelete: Cascade)

  @@id([chatId, storeId])
  @@index([storeId])
  @@map("store_members")
}
